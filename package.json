{
  "name": "sep-automation",
  "version": "1.0.0",
  "main": "index.js",
"scripts": {
  "test": "node -r dotenv/config ./node_modules/@cucumber/cucumber/bin/cucumber-js",
  "test:tag": "node -r dotenv/config ./node_modules/@cucumber/cucumber/bin/cucumber-js --tags @sep19",
  "test:tag:dryrun": "node -r dotenv/config ./node_modules/@cucumber/cucumber/bin/cucumber-js --tags @sep19 --dry-run",
  "test:smoke": "node -r dotenv/config ./node_modules/@cucumber/cucumber/bin/cucumber-js --tags @smoke",
  "Mac-open:report": "open reports/cucumber-report.html",
  "Windows-open:report": "start reports/cucumber-report.html"
},
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.53.2",
    "@types/node": "^22.16.0",
    "dotenv": "^18.0.8"
  },
  "dependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@faker-js/faker": "^10.4.0",
    "cucumber-html-reporter": "^5.0.2"
  }
}
